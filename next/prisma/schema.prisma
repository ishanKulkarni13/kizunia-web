model PlaceResolution {
  /// Provider place id, e.g. a Google place id.
  placeId           String                @id
  /// Identities representing the selected place *itself*, never its ancestors.
  /// May legitimately be empty for a place nothing is stored under, and is
  /// always empty when `status` is NOT_FOUND.
  identityKeys      String[]
  displayName       String?
  contextLabel      String?
  /// Which extraction ruleset produced these keys. A mismatch is treated as a
  /// miss, so changing extraction logically invalidates every row at once
  /// rather than leaving keys that no longer match what ingestion writes.
  extractionVersion Int
  resolvedAt        DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  /// Whether this row records a successful resolution or a permanent miss.
  status            PlaceResolutionStatus @default(RESOLVED)
  /// The place's own coordinates, as the provider reported them.
  ///
  /// This is the *anchor* a radius search measures from, and it is deliberately
  /// stored here rather than read from SearchArea: address-component areas —
  /// which is how every city, state and country acquires an identity — never
  /// carry coordinates, so SearchArea is null for exactly the places people
  /// search for most.
  ///
  /// Costs no new provider call. The Google identity field mask already
  /// requests `location`, and the provider already maps it; resolution simply
  /// discarded it before these columns existed.
  ///
  /// Nullable, because a row cached before this migration has none and because
  /// a provider may omit them. A null anchor must never be silently rendered as
  /// "nothing is here" — see RADIUS_ANCHOR_UNAVAILABLE.
  ///
  /// Decimal rather than Float so stored coordinates round-trip exactly,
  /// matching Location and SearchArea.
  latitude          Decimal?              @db.Decimal(9, 6)
  longitude         Decimal?              @db.Decimal(9, 6)

  @@index([resolvedAt])
  @@map("place_resolution")
}

/// Fixed-window request counter, keyed by caller and route.
///
/// Stored in Postgres rather than memory because the limiter has to hold across
/// instances — an in-memory counter silently stops limiting the moment the app
/// runs in more than one process, which is exactly when it matters.
model RateLimit {
  /// `{scope}:{identifier}:{windowStart}` — the window is part of the key, so
  /// expiry is a delete rather than a reset and two windows never collide.
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limit")
}


DATABASE_URL="postgresql://postgres:postgres@localhost:5433/kizunia"

# Dedicated database for `pnpm test:integration` — must be a database of its
# own, never the same one DATABASE_URL points at. Its name should contain
# "test" (e.g. "kizunia_test"); the integration test setup enforces this and
# refuses to run otherwise. See docs/testing/database.md.
DATABASE_TEST_URL="postgresql://postgres:postgres@localhost:5433/kizunia_test"

BETTER_AUTH_SECRET=yourSecreatKeyHereAnyRandomStringg
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL = http://localhost:3000

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME =
CLOUDINARY_API_KEY =
CLOUDINARY_API_SECRET =

# Location search (optional).
# Leaving these unset is a supported configuration: an admin can still enter
# locations manually and competitions save normally. Only discovery is narrower
# — a manually typed place yields no verified containment, so it is findable by
# its own name but not through a wider region.
#
# Google Places Autocomplete and Place Details are billed per session/call, and
# Address Descriptors (the containment evidence behind "everything in Pune")
# has limited regional availability and bills separately.
#
# Server-only. Never expose this as NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY =

# Override only to point at a stub or proxy during testing.
GOOGLE_PLACES_BASE_URL =

# Vercel's native Cron Jobs secret (see the `crons` entry in vercel.json).
# When set, Vercel sends it as `Authorization: Bearer <CRON_SECRET>` on every
# scheduled request. This is the one standard convention for scheduled
# internal jobs in this repository going forward — see
# docs/architecture/workflows/internal-jobs.md. Currently guards:
#
# Rate-limit counter prune (GET /api/v1/internal/rate-limit/prune)
# Asset orphan/cleanup sweep (GET /api/v1/internal/assets/reconcile)
CRON_SECRET =

# Internal, scheduler-triggered endpoint (optional in development).
# Not part of the session-based authorization model — protected by
# comparing this value against the `x-internal-secret` request header, and
# fails closed (401) if the variable is unset. Point an external scheduler at
# the endpoint only after setting the matching secret. This route has not
# yet been migrated to the CRON_SECRET convention above (see
# docs/architecture/workflows/internal-jobs.md) — out of scope for the Asset
# domain work that introduced that convention.
#
# Competition lifecycle sweep (recalculates automatic status for every
# eligible competition): POST /api/v1/internal/competitions/lifecycle
# IMPORTANT: before pointing a scheduler at this in production, run an
# unfiltered preview at /admin/competitions/lifecycle and review every
# proposed change first — every existing competition defaults to
# automaticStatusUpdatesDisabled = false, so the first sweep recalculates the
# entire table.
INTERNAL_LIFECYCLE_SECRET =

DATABASE_TEST_URL =
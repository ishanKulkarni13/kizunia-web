DATABASE_URL="postgresql://postgres:postgres@localhost:5433/kizunia"

# Dedicated database for `pnpm test:integration` — must be a database of its
# own, never the same one DATABASE_URL points at. Its name should contain
# "test" (e.g. "kizunia_test"); the integration test setup enforces this and
# refuses to run otherwise. See docs/testing/database.md.
DATABASE_TEST_URL="postgresql://postgres:postgres@localhost:5433/kizunia_test"

BETTER_AUTH_SECRET=yourSecreatKeyHereAnyRandomStringg
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL = http://localhost:3000

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME =
CLOUDINARY_API_KEY =
CLOUDINARY_API_SECRET =

# Location search (optional).
# Leaving these unset is a supported configuration: an admin can still enter
# locations manually and competitions save normally. Only discovery is narrower
# — a manually typed place yields no verified containment, so it is findable by
# its own name but not through a wider region.
#
# Google Places Autocomplete and Place Details are billed per session/call, and
# Address Descriptors (the containment evidence behind "everything in Pune")
# has limited regional availability and bills separately.
#
# Server-only. Never expose this as NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY =

# Override only to point at a stub or proxy during testing.
GOOGLE_PLACES_BASE_URL =

# Vercel's native Cron Jobs secret (see the `crons` entry in vercel.json).
# When set, Vercel sends it as `Authorization: Bearer <CRON_SECRET>` on every
# scheduled request. This is the one standard convention for scheduled
# internal jobs in this repository going forward — see
# docs/architecture/workflows/internal-jobs.md. Currently guards:
#
# The scheduled tick (GET /api/v1/internal/tick) — the single cron entry in
#   vercel.json. It dispatches a registry of tasks, each with its own cadence:
#   the notification sweep, the rate-limit prune, and the asset reconcile.
#   One endpoint because Vercel's Hobby plan allows only two cron entries at
#   daily granularity; see docs/architecture/notifications/IMPLEMENTATION-STATUS.md.
# Rate-limit counter prune (GET /api/v1/internal/rate-limit/prune)
# Asset orphan/cleanup sweep (GET /api/v1/internal/assets/reconcile)
#
# The last two remain individually invocable for a manual run.
CRON_SECRET =

# Internal, scheduler-triggered endpoint (optional in development).
# Not part of the session-based authorization model — protected by
# comparing this value against the `x-internal-secret` request header, and
# fails closed (401) if the variable is unset. Point an external scheduler at
# the endpoint only after setting the matching secret. This route has not
# yet been migrated to the CRON_SECRET convention above (see
# docs/architecture/workflows/internal-jobs.md) — out of scope for the Asset
# domain work that introduced that convention.
#
# Competition lifecycle sweep (recalculates automatic status for every
# eligible competition): POST /api/v1/internal/competitions/lifecycle
# IMPORTANT: before pointing a scheduler at this in production, run an
# unfiltered preview at /admin/competitions/lifecycle and review every
# proposed change first — every existing competition defaults to
# automaticStatusUpdatesDisabled = false, so the first sweep recalculates the
# entire table.
INTERNAL_LIFECYCLE_SECRET =

DATABASE_TEST_URL =

# Kizunia MCP server (see docs/architecture/mcp/README.md).
#
# No new environment variables are required — the MCP OAuth provider and
# resource identifier are derived from BETTER_AUTH_URL / NEXT_PUBLIC_APP_URL
# above (see src/modules/mcp/config.ts). Set BETTER_AUTH_URL to this
# deployment's real public origin before connecting an external MCP client
# (ChatGPT); "http://localhost:3000" only works for local development.

# ---------------------------------------------------------------------------
# Web push (Firebase Cloud Messaging)
# ---------------------------------------------------------------------------
# All of this is OPTIONAL. With none of it set, the notification system runs
# normally end to end: notifications are generated, stored, and delivered to
# the in-app inbox. Only the push channel is inert — the provider factory
# returns a fake that records sends instead of making them, and each push
# delivery is recorded as SKIPPED with a stated reason rather than as a send
# that never happened.
#
# Set these to turn push on. Nothing else changes.

# --- Server credentials (service account) ----------------------------------
# From the Firebase console: Project settings > Service accounts > Generate new
# private key. That gives a JSON file; take three fields from it.
#
# THREE VARIABLES, NOT THE JSON BLOB. The blob is what Firebase hands you and
# is tempting for that reason, but it does not survive Vercel's environment UI
# intact, and a partially-mangled JSON string fails at the first send rather
# than at deploy time.
#
# FIREBASE_PRIVATE_KEY is a PEM body containing newlines, which an environment
# variable cannot hold literally. Paste it with the newlines escaped as \n
# (and wrapped in quotes); the application unescapes it at load. It is a server
# credential and must never reach a browser — note the absence of a
# NEXT_PUBLIC_ prefix, which is what keeps it out of the client bundle.
FIREBASE_PROJECT_ID =
FIREBASE_CLIENT_EMAIL =
FIREBASE_PRIVATE_KEY =

# --- Browser config (public) -----------------------------------------------
# From the Firebase console: Project settings > General > Your apps > Web app.
# These are public by design — they identify the project, they do not
# authenticate anything.
NEXT_PUBLIC_FIREBASE_API_KEY =
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN =
NEXT_PUBLIC_FIREBASE_PROJECT_ID =
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID =
NEXT_PUBLIC_FIREBASE_APP_ID =

# The Web Push certificate key pair, from Project settings > Cloud Messaging >
# Web configuration. Required by getToken(); without it the browser cannot
# produce a push token at all.
NEXT_PUBLIC_FIREBASE_VAPID_KEY =

# ---------------------------------------------------------------------------
# Notification tuning (all optional)
# ---------------------------------------------------------------------------
# Every value below has a considered default in
# src/modules/notifications/config/notification-config.ts, which also records
# why each number is what it is. These overrides exist for deployment
# differences, not for routine configuration.

# The hour (UTC) of the daily evaluation. Default 13 — early afternoon in
# Europe, morning in the Americas, evening in India. No hour is good
# everywhere; this one is bad nowhere.
NOTIFICATION_DAILY_HOUR_UTC =

# How often the worker sweep actually runs, in seconds. Default 86400 (daily),
# which is what a Vercel Hobby deployment gets.
#
# THIS MUST MATCH REALITY. The deadline-notification window is derived from it,
# and is exactly one sweep interval wide so consecutive sweeps tile without a
# gap. A deployment that ticks daily but claims to tick every five minutes will
# leave deadlines nobody is ever told about.
NOTIFICATION_SWEEP_INTERVAL_SECONDS =

# Total job attempts including the first. Default 5.
# On a daily-cadence deployment, LOWER THIS to about 3: a retry scheduled a
# minute out is not actually attempted for a day, so five attempts is a
# five-day horizon — far longer than a notification about a deadline stays
# useful.
NOTIFICATION_JOB_MAX_ATTEMPTS =

# Wall-clock budget for one drain pass, in milliseconds. Default 45000, sized
# for Vercel's 60s Hobby function limit with room for one more job plus
# teardown. Raise it alongside `maxDuration` in the tick route on a plan that
# allows longer executions.
NOTIFICATION_WORKER_BUDGET_MS =

# Whether a drain pass that still has work re-invokes the drain endpoint over
# the network before returning. Default off.
# Useful on a platform that allows only a daily trigger — without it, a backlog
# drains one batch per day — but it re-enters the application over HTTP and
# needs the shared secret in-process.
NOTIFICATION_WORKER_SELF_CONTINUE =

# How long a submitted competition suggestion must sit before reviewers are
# told about it, in seconds. Default 1800 (30 minutes) — the floor of the
# product's "near-real-time, 30-60 minutes, deliberately not instant" target.
# Lower this locally (e.g. 60) so a submitted suggestion doesn't take 30
# minutes to show up when testing the ADMIN_COMPETITION_SUGGESTION flow.
NOTIFICATION_ADMIN_SUGGESTION_DELAY_SECONDS =

# How far back the admin-suggestion discovery sweep looks for suggestions
# still awaiting review, in seconds. Default 604800 (7 days) — bounds the scan
# and stops the first deployment of this feature from paging everyone about a
# pre-existing backlog. A suggestion older than this that was never notified
# stays un-notified, still visible in the ordinary review queue.
NOTIFICATION_ADMIN_SUGGESTION_LOOKBACK_SECONDS =

# Suggestions one admin-suggestion discovery pass will enqueue notices for.
# Default 500. A ceiling on one pass, not on the queue — the next tick
# continues from the start, since anything already enqueued collides
# harmlessly on its dedupe key.
NOTIFICATION_ADMIN_SUGGESTION_DISCOVERY_LIMIT =


# ---------------------------------------------------------------------------
# Subscription billing (Razorpay)
# ---------------------------------------------------------------------------
# All of this is OPTIONAL. With none of it set, billing is DISABLED: the app
# boots and runs normally, Free membership, admin grants and every entitlement
# gate keep working, and only starting or changing a PAID subscription answers
# "503 BILLING_UNAVAILABLE". Nothing here is needed for local development
# unless you are working on billing itself.
#
# The credentials are all-or-nothing. Setting some but not all of the three
# below fails at server start (it does not guess), naming what is missing.
#
# Server-only secrets. Never expose any of these as NEXT_PUBLIC_.
#
# Test and live use separate key pairs, webhook secrets, plans and offers, and
# never mix. The mode is read from the key: `rzp_test_...` is TEST,
# `rzp_live_...` is LIVE; any other prefix fails at server start.
RAZORPAY_KEY_ID =
RAZORPAY_KEY_SECRET =

# Verifies webhook signatures. A DIFFERENT secret from the key secret, set on
# the webhook in the Razorpay Dashboard, and separate for test and live.
RAZORPAY_WEBHOOK_SECRET =

# Your Razorpay merchant account id (acc_...). Required once the credentials
# above are set: a webhook payload from any other account is rejected.
RAZORPAY_ACCOUNT_ID =

# Rotating the webhook secret only. Razorpay signs RETRIES of events created
# before a rotation with the OLD secret, so keep it here for at least 24 hours
# after the rotation, then remove it. The optional _UNTIL (an ISO 8601
# timestamp, e.g. 2026-10-01T00:00:00Z) stops accepting it at that instant;
# without it the old secret is accepted until you remove it.
# See docs/architecture/subscription/cross-cutting/operations-runbook.md.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS =
RAZORPAY_WEBHOOK_SECRET_PREVIOUS_UNTIL =

# Which provider mode's subscriptions are REAL for this deployment: `test` or
# `live`. Only subscriptions created in this mode grant access, so a test
# subscription can never grant access in production, whatever keys are set.
#
# Left unset: `live` when VERCEL_ENV=production, otherwise `test`. Set it
# explicitly in every deployment that has credentials. If credentials are set
# and their mode differs from this, the server refuses to start; no
# credentials at all is always allowed.
BILLING_EXPECTED_MODE =

# ---------------------------------------------------------------------------
# Billing tuning (all optional)
# ---------------------------------------------------------------------------
# Every value below has a considered default in
# src/modules/billing/config/billing-config.ts, which also records why each
# number is what it is. Razorpay publishes no rate-limit numbers, so these are
# deliberately conservative until Razorpay Support confirms the account's.

# Outbound provider request budget, shared by every instance: at most
# BILLING_BUDGET_LIMIT calls per BILLING_BUDGET_WINDOW_SECONDS. Defaults 60
# calls per 60 seconds.
BILLING_BUDGET_WINDOW_SECONDS =
BILLING_BUDGET_LIMIT =

# Calls in each window kept back for higher-priority callers. Customer commands
# may use the whole window; checkout confirmation and webhook-triggered syncs
# lose HEADROOM_P1; scheduled reconciliation loses HEADROOM_P1 + HEADROOM_P2.
# Defaults 15 and 15.
BILLING_BUDGET_HEADROOM_P1 =
BILLING_BUDGET_HEADROOM_P2 =

# The most calls orphan discovery may use in a window, so it only runs while
# the window is otherwise quiet. Default 10.
BILLING_BUDGET_ORPHAN_CEILING =

# Retry delay after a failed provider read of one subscription: base * 2^n,
# jittered, capped. Defaults 60 seconds and 21600 (6 hours).
BILLING_BACKOFF_BASE_SECONDS =
BILLING_BACKOFF_CAP_SECONDS =

# The global cooldown entered on a 429, or after this many consecutive
# timeouts/5xx: base * 2^level, jittered, capped. While it is set only
# customer commands still call the provider. Defaults 30 seconds, 900 (15
# minutes) and 5 failures.
BILLING_COOLDOWN_BASE_SECONDS =
BILLING_COOLDOWN_CAP_SECONDS =
BILLING_COOLDOWN_FAILURE_THRESHOLD =

# How long one provider request may take before it counts as a timeout.
# Default 10000 (10 seconds).
BILLING_PROVIDER_TIMEOUT_MS =

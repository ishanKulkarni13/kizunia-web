generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                              String                    @id
  name                            String
  email                           String                    @unique
  emailVerified                   Boolean                   @default(false)
  image                           String?
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime                  @updatedAt
  role                            String?
  banned                          Boolean?                  @default(false)
  banReason                       String?
  banExpires                      DateTime?
  username                        String?                   @unique
  displayUsername                 String?
  avatarAssetId                   String?
  coverAssetId                    String?
  visibility                      UserVisibility            @default(PUBLIC)
  status                          UserStatus                @default(ACTIVE)
  accounts                        Account[]
  uploadedAssets                  Asset[]                   @relation("assetUploadedBy")
  competitionsCreated             Competition[]             @relation("competitionCreatedBy")
  competitionsUpdated             Competition[]             @relation("competitionUpdatedBy")
  competitionBookmarks            CompetitionBookmark[]
  competitionMembers              CompetitionMember[]
  competitionRegistrations        CompetitionRegistration[]
  competitionSuggestionsReviewed  CompetitionSuggestion[]   @relation("competitionSuggestionReviewedBy")
  competitionSuggestionsSubmitted CompetitionSuggestion[]   @relation("competitionSuggestionSubmittedBy")
  links                           Link[]
  notificationPreferences         NotificationPreference[]
  competitionPreferences          CompetitionPreference[]
  portfolio                       Portfolio?
  projectsCreated                 Project[]                 @relation("projectCreatedBy")
  projectsUpdated                 Project[]                 @relation("projectUpdatedBy")
  projectMembers                  ProjectMember[]
  sessions                        Session[]
  uploadIntents                   UploadIntent[]            @relation("uploadIntentActor")
  avatarAsset                     Asset?                    @relation("userAvatar", fields: [avatarAssetId], references: [id])
  coverAsset                      Asset?                    @relation("userCover", fields: [coverAssetId], references: [id])
  badges                          UserBadge[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Link {
  id                      String                 @id @default(cuid())
  url                     String
  title                   String
  type                    LinkType
  order                   Int                    @default(0)
  userId                  String?
  competitionId           String?
  projectId               String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  competitionSuggestionId String?
  portfolioId             String?
  competition             Competition?           @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  competitionSuggestion   CompetitionSuggestion? @relation(fields: [competitionSuggestionId], references: [id])
  portfolio               Portfolio?             @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  project                 Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                    User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([competitionId])
  @@index([portfolioId])
  @@index([projectId])
  @@index([competitionSuggestionId])
  @@map("link")
}

model Asset {
  id                        String                       @id @default(cuid())
  provider                  AssetProvider
  publicId                  String                       @unique
  secureUrl                 String
  format                    String?
  mimeType                  String?
  width                     Int?
  height                    Int?
  bytes                     Int?
  checksum                  String?
  originalFilename          String?
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  category                  AssetCategory                @default(IMAGE)
  detachedAt                DateTime?
  status                    AssetStatus                  @default(ACTIVE)
  uploadedById              String?
  uploadedBy                User?                        @relation("assetUploadedBy", fields: [uploadedById], references: [id])
  badgeIcons                Badge[]                      @relation("badgeIcon")
  competitionBanner         Competition[]                @relation("competitionBanner")
  competitionCover          Competition[]                @relation("competitionCover")
  competitionLogo           Competition[]                @relation("competitionLogo")
  suggestionAssets          CompetitionSuggestionAsset[]
  portfolioResume           Portfolio[]                  @relation("portfolioResume")
  achievementAssets         PortfolioAchievement[]       @relation("achievementAsset")
  certificationAssets       PortfolioCertification[]     @relation("certificationAsset")
  educationInstitutionLogos PortfolioEducation[]         @relation("educationInstitutionLogo")
  experienceCompanyLogos    PortfolioExperience[]        @relation("experienceCompanyLogo")
  projectCover              Project[]                    @relation("projectCover")
  projectLogo               Project[]                    @relation("projectLogo")
  technologyIcons           Technology[]                 @relation("technologyIcon")
  testimonialImages         Testimonial[]                @relation("testimonialImage")
  userAvatar                User[]                       @relation("userAvatar")
  userCover                 User[]                       @relation("userCover")

  @@index([status])
  @@index([status, detachedAt])
  @@index([status, createdAt])
  @@index([uploadedById])
  @@map("asset")
}

model UploadIntent {
  id                    String             @id @default(cuid())
  actorId               String
  purpose               AssetPurpose
  category              AssetCategory
  targetEntityType      String?
  targetEntityId        String?
  providerCorrelationId String             @unique
  declaredMimeType      String
  declaredSize          Int
  status                UploadIntentStatus @default(PENDING)
  resultAssetId         String?
  expiresAt             DateTime
  createdAt             DateTime           @default(now())
  actor                 User               @relation("uploadIntentActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, status])
  @@index([expiresAt])
  @@map("upload_intent")
}

model Technology {
  id           String                  @id @default(cuid())
  name         String                  @unique
  slug         String                  @unique
  description  String?
  type         TechnologyType
  iconAssetId  String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  deletedAt    DateTime?
  competitions CompetitionTechnology[]
  portfolios   PortfolioTechnology[]
  projects     ProjectTechnology[]
  iconAsset    Asset?                  @relation("technologyIcon", fields: [iconAssetId], references: [id])

  @@index([deletedAt])
  @@map("technology")
}

model Category {
  id           String                @id @default(cuid())
  name         String                @unique
  slug         String                @unique
  competitions CompetitionCategory[]
  projects     ProjectCategory[]

  @@map("category")
}

model Badge {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  iconAssetId String?
  iconAsset   Asset?         @relation("badgeIcon", fields: [iconAssetId], references: [id])
  projects    ProjectBadge[]
  users       UserBadge[]

  @@map("badge")
}

model UserBadge {
  userId   String
  badgeId  String
  issuedAt DateTime @default(now())
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@map("user_badge")
}

enum NotificationIntent {
  TOP_RELEVANT_COMPETITION
  // Add future intents (e.g. REGISTRATION_CLOSING) here only when they are
  // actually built — a new value plus an additive migration, never a
  // restructure of this model.
}

model NotificationPreference {
  id        String             @id @default(cuid())
  userId    String
  intent    NotificationIntent
  enabled   Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, intent])
  @@index([userId])
  @@map("notification_preference")
}

// Values must mirror DimensionId in modules/recommendations/engine/types.ts
// exactly — this is the persisted form of that TS union, not an
// independently-maintained enum. Adding a 14th dimension there means adding
// the matching value here, nothing else.
enum CompetitionPreferenceDimension {
  mode
  categories
  technologies
  eligibilities
  location
  registrationPlatform
  registrationType
  registrationFeeType
  organizerType
  difficulty
  certificateType
  status
  teamSize
}

model CompetitionPreference {
  id        String                         @id @default(cuid())
  userId    String
  dimension CompetitionPreferenceDimension
  value     String
  weight    Float
  createdAt DateTime                       @default(now())
  updatedAt DateTime                       @updatedAt
  user      User                           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dimension, value])
  @@index([userId])
  @@map("competition_preference")
}

model Competition {
  id                             String                    @id @default(cuid())
  title                          String
  slug                           String                    @unique
  shortDescription               String?
  organizer                      String?
  mode                           CompetitionMode?
  minTeamSize                    Int?
  maxTeamSize                    Int?
  registrationLink               String?
  website                        String?
  startDate                      DateTime?
  endDate                        DateTime?
  registrationDeadline           DateTime?
  prizePool                      String?
  logoAssetId                    String?
  bannerAssetId                  String?
  coverAssetId                   String?
  contentId                      String?                   @unique
  visibility                     CompetitionVisibility     @default(PRIVATE)
  status                         CompetitionStatus?
  createdById                    String?
  updatedById                    String?
  createdAt                      DateTime                  @default(now())
  updatedAt                      DateTime                  @updatedAt
  deletedAt                      DateTime?
  registrationPlatform           RegistrationPlatform?
  registrationType               RegistrationType?
  registrationFeeType            RegistrationFeeType?
  registrationFee                String?
  organizerType                  OrganizerType?
  difficulty                     DifficultyLevel?
  certificateType                CertificateType?
  automaticStatusUpdatesDisabled Boolean                   @default(false)
  registrationStartDate          DateTime?
  statusUpdatedAt                DateTime?
  bannerAsset                    Asset?                    @relation("competitionBanner", fields: [bannerAssetId], references: [id])
  content                        Content?                  @relation("CompetitionContent", fields: [contentId], references: [id])
  coverAsset                     Asset?                    @relation("competitionCover", fields: [coverAssetId], references: [id])
  createdBy                      User?                     @relation("competitionCreatedBy", fields: [createdById], references: [id])
  logoAsset                      Asset?                    @relation("competitionLogo", fields: [logoAssetId], references: [id])
  updatedBy                      User?                     @relation("competitionUpdatedBy", fields: [updatedById], references: [id])
  bookmarks                      CompetitionBookmark[]
  categories                     CompetitionCategory[]
  eligibilities                  CompetitionEligibility[]
  locations                      CompetitionLocation[]
  members                        CompetitionMember[]
  projects                       CompetitionProject[]
  registrations                  CompetitionRegistration[]
  suggestions                    CompetitionSuggestion[]   @relation("competitionSuggestionTarget")
  technologies                   CompetitionTechnology[]
  links                          Link[]

  @@index([status])
  @@index([visibility])
  @@index([deletedAt])
  @@index([startDate])
  @@index([registrationDeadline])
  @@index([registrationStartDate])
  @@index([createdById])
  @@index([updatedById])
  @@map("competition")
}

model CompetitionSuggestion {
  id                  String                       @id @default(cuid())
  status              SuggestionStatus             @default(DRAFT)
  submittedAt         DateTime?
  reviewedAt          DateTime?
  reviewNotes         String?
  rejectionReason     String?
  competitionId       String?
  submittedById       String
  reviewedById        String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  deletedAt           DateTime?
  suggestionContentId String?                      @unique
  suggestionTitle     String
  competition         Competition?                 @relation("competitionSuggestionTarget", fields: [competitionId], references: [id])
  reviewedBy          User?                        @relation("competitionSuggestionReviewedBy", fields: [reviewedById], references: [id])
  submittedBy         User                         @relation("competitionSuggestionSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)
  suggestionContent   Content?                     @relation("CompetitionSuggestionContent", fields: [suggestionContentId], references: [id])
  assets              CompetitionSuggestionAsset[]
  links               Link[]

  @@index([status])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([competitionId])
  @@index([createdAt])
  @@map("competition_suggestion")
}

model CompetitionSuggestionAsset {
  suggestionId String
  assetId      String
  order        Int                   @default(0)
  createdAt    DateTime              @default(now())
  asset        Asset                 @relation(fields: [assetId], references: [id], onDelete: Cascade)
  suggestion   CompetitionSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@id([suggestionId, assetId])
  @@index([suggestionId, order])
  @@index([assetId])
  @@map("competition_suggestion_asset")
}

model CompetitionMember {
  competitionId String
  userId        String
  role          CompetitionMemberRole @default(MAINTAINER)
  assignedAt    DateTime              @default(now())
  competition   Competition           @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([competitionId, userId])
  @@map("competition_member")
}

model CompetitionCategory {
  competitionId String
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@id([competitionId, categoryId])
  @@map("competition_category")
}

model CompetitionTechnology {
  competitionId String
  technologyId  String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  technology    Technology  @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([competitionId, technologyId])
  @@map("competition_technology")
}

model CompetitionEligibility {
  competitionId String
  type          EligibilityType
  competition   Competition     @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@id([competitionId, type])
  @@index([type])
  @@map("competition_eligibility")
}

model CompetitionBookmark {
  competitionId String
  userId        String
  createdAt     DateTime    @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([competitionId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("competition_bookmark")
}

/// A user's own record that they registered for this competition on the
/// organizer's external platform.
///
/// SELF-DECLARED AND UNVERIFIED. Kizunia is a discovery platform, not the
/// organizer, and has no channel to confirm any of this. Nothing here may
/// ever be presented as organizer-confirmed. There is deliberately no
/// `source`, no `verifiedAt` and no status enum — each would imply a
/// verification pipeline that does not exist and is not planned.
///
/// Fully independent of CompetitionBookmark. All four combinations of
/// (bookmarked, registered) are legal and neither write ever touches the
/// other table.
///
/// Never removed by lifecycle. A row here survives every CompetitionStatus,
/// including COMPLETED and CANCELLED — "I registered for that" stays true
/// after the event ends. Past-vs-upcoming is derived at read time from the
/// competition's dates, never by deleting rows.
model CompetitionRegistration {
  competitionId String
  userId        String
  /// When the user told us. NOT when they actually registered with the
  /// organizer — we cannot know that.
  markedAt      DateTime    @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([competitionId, userId])
  @@index([userId, markedAt(sort: Desc)])
  @@map("competition_registration")
}

/// A real-world place, stored at whatever precision is actually known.
///
/// Locations are deliberately NOT deduplicated across competitions. Two
/// competitions in Pune each own a private Location row, so editing one can
/// never silently rewrite another competition's data. The cost of duplicate
/// rows is far lower than the cost of fuzzy place matching.
model Location {
  id                 String                @id @default(cuid())
  /// Human-readable name shown in the UI, e.g. "Pune, Maharashtra, India".
  /// This is the only field an admin is ever required to supply.
  displayName        String
  precision          LocationPrecision     @default(UNKNOWN)
  country            String?
  /// ISO 3166-1 alpha-2, uppercase.
  countryCode        String?               @db.VarChar(2)
  state              String?
  stateCode          String?
  city               String?
  postalCode         String?
  /// Decimal rather than Float so stored coordinates round-trip exactly.
  /// 6 decimal places is roughly 0.11 m at the equator.
  latitude           Decimal?              @db.Decimal(9, 6)
  longitude          Decimal?              @db.Decimal(9, 6)
  /// IANA timezone identifier, e.g. "Asia/Kolkata".
  timezone           String?
  provider           LocationProvider      @default(MANUAL)
  /// Opaque id from the external provider. Kept for re-enrichment only —
  /// never required to read a Location back.
  providerLocationId String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  competitions       CompetitionLocation[]
  searchAreas        LocationSearchArea[]

  @@index([countryCode])
  @@index([city])
  @@index([state])
  @@index([provider, providerLocationId])
  @@index([latitude, longitude])
  @@map("location")
}

/// A specific geographic entity a user can select as a search boundary.
///
/// A SearchArea is an *entity*, never a name. "Nashik City" and "Nashik
/// District" share a word but have different boundaries and different search
/// semantics, so they are two rows — distinguished by `identityKey`, which is
/// derived from provider identity wherever one exists.
///
/// Unlike Location (which is competition-owned and never shared), SearchAreas
/// are deliberately reused: every competition in Pune links to the same Pune
/// row, which is what makes "everything in Pune" a single indexed lookup.
model SearchArea {
  id                 String               @id @default(cuid())
  displayName        String
  /// The provider's own type string, stored verbatim — "locality",
  /// "administrative_area_level_2", "sublocality_level_1", "university".
  ///
  /// Display and disambiguation only; nothing branches on it. Deliberately not
  /// a Kizunia enum, because any fixed set would encode one country's
  /// administrative hierarchy as though it were universal.
  providerKind       String?
  /// Parent context for pickers, e.g. "Maharashtra, India", so a user can tell
  /// two same-named entities apart. Display only.
  contextLabel       String?
  provider           LocationProvider?
  providerLocationId String?
  /// Deterministic identity, and the dedup key:
  /// google:place:{placeId}                        preferred, whenever available
  /// component:{providerKind}:{name}:{parent ctx}  fallback only
  ///
  /// Never the display name alone. That would collapse Nashik City and Nashik
  /// District into one entity and merge unrelated places that share a name.
  identityKey        String               @unique
  latitude           Decimal?             @db.Decimal(9, 6)
  longitude          Decimal?             @db.Decimal(9, 6)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  locations          LocationSearchArea[]

  @@index([displayName])
  @@map("search_area")
}

/// Verified containment: this location is discoverable through this area.
///
/// Containment is materialized here at ingestion rather than traversed at query
/// time. That is what makes a parent search reach its children (they each point
/// at the parent) while making upward or sideways expansion impossible — a
/// Kondhwa location simply has no Bibwewadi row, so it can never surface there.
model LocationSearchArea {
  locationId   String
  searchAreaId String
  relation     SearchAreaRelation
  /// Which provider evidence produced this link. Kept so "why is this
  /// competition discoverable through Bibwewadi?" is answerable later.
  source       SearchAreaSource
  createdAt    DateTime           @default(now())
  location     Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  searchArea   SearchArea         @relation(fields: [searchAreaId], references: [id], onDelete: Cascade)

  @@id([locationId, searchAreaId])
  @@index([searchAreaId])
  @@map("location_search_area")
}

/// How one competition uses one location.
///
/// Carries its own identity rather than a composite key because the same place
/// can legitimately host two stages of one competition (a Pune qualifier and a
/// Pune final), and because label/venue/dates describe the *usage*, not the place.
model CompetitionLocation {
  id            String      @id @default(cuid())
  competitionId String
  locationId    String
  /// Free-form context for this stop, e.g. "Qualifier", "Final",
  /// "Opening Ceremony". Deliberately not an enum — competition structures vary
  /// too widely to enumerate, and nothing in the system branches on this value.
  label         String?
  venueName     String?
  address       String?
  /// Dates for this location specifically. May differ from the competition's
  /// overall window, e.g. a regional qualifier inside a three-month event.
  startDate     DateTime?
  endDate       DateTime?
  /// Admin-defined display order. Database row order is never relied upon.
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  location      Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([competitionId, order])
  @@index([locationId])
  @@map("competition_location")
}

model Project {
  id               String               @id @default(cuid())
  title            String
  slug             String               @unique
  shortDescription String
  contentId        String?              @unique
  visibility       ProjectVisibility    @default(PUBLIC)
  status           ProjectStatus        @default(DRAFT)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  logoAssetId      String?
  coverAssetId     String?
  createdById      String?
  updatedById      String?
  deletedAt        DateTime?
  endDate          DateTime?
  startDate        DateTime?
  competitions     CompetitionProject[]
  links            Link[]
  portfolios       PortfolioProject[]
  content          Content?             @relation("ProjectContent", fields: [contentId], references: [id])
  coverAsset       Asset?               @relation("projectCover", fields: [coverAssetId], references: [id])
  createdBy        User?                @relation("projectCreatedBy", fields: [createdById], references: [id])
  logoAsset        Asset?               @relation("projectLogo", fields: [logoAssetId], references: [id])
  updatedBy        User?                @relation("projectUpdatedBy", fields: [updatedById], references: [id])
  badges           ProjectBadge[]
  categories       ProjectCategory[]
  members          ProjectMember[]
  technologies     ProjectTechnology[]
  testimonials     Testimonial[]        @relation("projectTestimonials")

  @@index([slug])
  @@index([status])
  @@index([visibility])
  @@index([deletedAt])
  @@index([createdById])
  @@index([updatedById])
  @@map("project")
}

model ProjectMember {
  projectId String
  userId    String
  role      ProjectRole @default(CONTRIBUTOR)
  joinedAt  DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_member")
}

model ProjectCategory {
  projectId  String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, categoryId])
  @@map("project_category")
}

model ProjectTechnology {
  projectId    String
  technologyId String
  displayOrder Int        @default(0)
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@index([projectId, displayOrder])
  @@map("project_technology")
}

model ProjectBadge {
  projectId String
  badgeId   String
  issuedAt  DateTime @default(now())
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, badgeId])
  @@map("project_badge")
}

model CompetitionProject {
  competitionId String
  projectId     String
  submittedAt   DateTime    @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([competitionId, projectId])
  @@map("competition_project")
}

model PortfolioProject {
  portfolioId  String
  projectId    String
  featured     Boolean   @default(false)
  /// @deprecated Unused. No DTO exposes it, no API writes it, and no product
  /// behaviour depends on it. The only remaining reader is the public
  /// portfolio query's `hidden: false` filter, kept solely to preserve
  /// pre-existing behaviour. Planned for removal in a future schema cleanup —
  /// do not assign it new semantics.
  hidden       Boolean   @default(false)
  displayOrder Int       @default(100)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([portfolioId, projectId])
  @@index([portfolioId, displayOrder])
  @@map("portfolio_project")
}

model Portfolio {
  id                 String                   @id @default(cuid())
  userId             String                   @unique
  headline           String?
  phone              String?
  publicContactEmail String?
  location           String?
  visibility         PortfolioVisibility      @default(PUBLIC)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  deletedAt          DateTime?
  resumeAssetId      String?
  bio                String?
  displayName        String
  links              Link[]
  resumeAsset        Asset?                   @relation("portfolioResume", fields: [resumeAssetId], references: [id])
  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievements       PortfolioAchievement[]
  certifications     PortfolioCertification[]
  education          PortfolioEducation[]
  experience         PortfolioExperience[]
  projects           PortfolioProject[]
  settings           PortfolioSettings?
  technologies       PortfolioTechnology[]
  testimonials       Testimonial[]            @relation("portfolioTestimonials")

  @@index([userId])
  @@index([visibility])
  @@index([deletedAt])
  @@map("portfolio")
}

model PortfolioSettings {
  id             String    @id @default(cuid())
  theme          String    @default("default")

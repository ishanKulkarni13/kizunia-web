generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                              String                    @id
  name                            String
  email                           String                    @unique
  emailVerified                   Boolean                   @default(false)
  image                           String?
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime                  @updatedAt
  role                            String?
  banned                          Boolean?                  @default(false)
  banReason                       String?
  banExpires                      DateTime?
  username                        String?                   @unique
  displayUsername                 String?
  avatarAssetId                   String?
  coverAssetId                    String?
  visibility                      UserVisibility            @default(PUBLIC)
  status                          UserStatus                @default(ACTIVE)
  accounts                        Account[]
  uploadedAssets                  Asset[]                   @relation("assetUploadedBy")
  competitionsCreated             Competition[]             @relation("competitionCreatedBy")
  competitionsUpdated             Competition[]             @relation("competitionUpdatedBy")
  competitionBookmarks            CompetitionBookmark[]
  competitionMembers              CompetitionMember[]
  competitionRegistrations        CompetitionRegistration[]
  competitionSuggestionsReviewed  CompetitionSuggestion[]   @relation("competitionSuggestionReviewedBy")
  competitionSuggestionsSubmitted CompetitionSuggestion[]   @relation("competitionSuggestionSubmittedBy")
  links                           Link[]
  notificationPreferences         NotificationPreference[]
  competitionPreferences          CompetitionPreference[]
  notifications                   Notification[]
  pushSubscriptions               PushSubscription[]
  featureAnnouncementsCreated     FeatureAnnouncement[]     @relation("featureAnnouncementCreatedBy")
  portfolio                       Portfolio?
  projectsCreated                 Project[]                 @relation("projectCreatedBy")
  projectsUpdated                 Project[]                 @relation("projectUpdatedBy")
  projectMembers                  ProjectMember[]
  sessions                        Session[]
  uploadIntents                   UploadIntent[]            @relation("uploadIntentActor")
  avatarAsset                     Asset?                    @relation("userAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)
  coverAsset                      Asset?                    @relation("userCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  badges                          UserBadge[]

  // ---------------------------------------------------------------------------
  // MCP / OAuth provider
  // ---------------------------------------------------------------------------
  oauthApplications OauthApplication[] @relation("oauthApplicationOwner")
  oauthAccessTokens OauthAccessToken[] @relation("oauthAccessTokenUser")
  oauthConsents     OauthConsent[]     @relation("oauthConsentUser")

  // ---------------------------------------------------------------------------
  // Subscription & Billing — entitlement grants (Phase I)
  // ---------------------------------------------------------------------------
  entitlementGrants EntitlementGrant[] @relation("entitlementGrantRecipient")
  grantAuditEntries GrantAuditEntry[]  @relation("grantAuditTarget")

  // ---------------------------------------------------------------------------
  // Subscription & Billing — promotions (Phase VII)
  // ---------------------------------------------------------------------------
  promotionRedemptions PromotionRedemption[] @relation("promotionRedeemer")

  // ---------------------------------------------------------------------------
  // Subscription & Billing — billing persistence (Phase III)
  // ---------------------------------------------------------------------------
  subscriptions              Subscription[]             @relation("subscriptionOwner")
  billingOperations          BillingOperation[]         @relation("billingOperationUser")
  billingMoneyFacts          BillingMoneyFact[]         @relation("billingMoneyFactUser")
  subscriptionHistoryEntries SubscriptionHistoryEntry[] @relation("subscriptionHistoryUser")
  billingAnomalies           BillingAnomaly[]           @relation("billingAnomalyUser")

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Link {
  id                      String                 @id @default(cuid())
  url                     String
  title                   String
  type                    LinkType
  order                   Int                    @default(0)
  userId                  String?
  competitionId           String?
  projectId               String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  competitionSuggestionId String?
  portfolioId             String?
  competition             Competition?           @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  competitionSuggestion   CompetitionSuggestion? @relation(fields: [competitionSuggestionId], references: [id])
  portfolio               Portfolio?             @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  project                 Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                    User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([competitionId])
  @@index([portfolioId])
  @@index([projectId])
  @@index([competitionSuggestionId])
  @@map("link")
}

model Asset {
  id                        String                       @id @default(cuid())
  provider                  AssetProvider
  publicId                  String                       @unique
  secureUrl                 String
  format                    String?
  mimeType                  String?
  width                     Int?
  height                    Int?
  bytes                     Int?
  checksum                  String?
  originalFilename          String?
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  category                  AssetCategory                @default(IMAGE)
  detachedAt                DateTime?
  status                    AssetStatus                  @default(ACTIVE)
  uploadedById              String?
  uploadedBy                User?                        @relation("assetUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  badgeIcons                Badge[]                      @relation("badgeIcon")
  competitionBanner         Competition[]                @relation("competitionBanner")
  competitionCover          Competition[]                @relation("competitionCover")
  competitionLogo           Competition[]                @relation("competitionLogo")
  suggestionAssets          CompetitionSuggestionAsset[]
  portfolioResume           Portfolio[]                  @relation("portfolioResume")
  achievementAssets         PortfolioAchievement[]       @relation("achievementAsset")
  certificationAssets       PortfolioCertification[]     @relation("certificationAsset")
  educationInstitutionLogos PortfolioEducation[]         @relation("educationInstitutionLogo")
  experienceCompanyLogos    PortfolioExperience[]        @relation("experienceCompanyLogo")
  projectCover              Project[]                    @relation("projectCover")
  projectLogo               Project[]                    @relation("projectLogo")
  technologyIcons           Technology[]                 @relation("technologyIcon")
  testimonialImages         Testimonial[]                @relation("testimonialImage")
  userAvatar                User[]                       @relation("userAvatar")
  userCover                 User[]                       @relation("userCover")

  @@index([status])
  @@index([status, detachedAt])
  @@index([status, createdAt])
  @@index([uploadedById])
  @@map("asset")
}

model UploadIntent {
  id                    String             @id @default(cuid())
  actorId               String
  purpose               AssetPurpose
  category              AssetCategory
  targetEntityType      String?
  targetEntityId        String?
  providerCorrelationId String             @unique
  declaredMimeType      String
  declaredSize          Int
  status                UploadIntentStatus @default(PENDING)
  resultAssetId         String?
  expiresAt             DateTime
  createdAt             DateTime           @default(now())
  actor                 User               @relation("uploadIntentActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, status])
  @@index([expiresAt])
  @@map("upload_intent")
}

model Technology {
  id           String                  @id @default(cuid())
  name         String                  @unique
  slug         String                  @unique
  description  String?
  type         TechnologyType
  iconAssetId  String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  deletedAt    DateTime?
  competitions CompetitionTechnology[]
  portfolios   PortfolioTechnology[]
  projects     ProjectTechnology[]
  iconAsset    Asset?                  @relation("technologyIcon", fields: [iconAssetId], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@map("technology")
}

model Category {
  id           String                @id @default(cuid())
  name         String                @unique
  slug         String                @unique
  competitions CompetitionCategory[]
  projects     ProjectCategory[]

  @@map("category")
}

model Badge {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  iconAssetId String?
  iconAsset   Asset?         @relation("badgeIcon", fields: [iconAssetId], references: [id], onDelete: SetNull)
  projects    ProjectBadge[]
  users       UserBadge[]

  @@map("badge")
}

model UserBadge {
  userId   String
  badgeId  String
  issuedAt DateTime @default(now())
  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@map("user_badge")
}

/// One notification type. Adding a value here is additive; it also forces a
/// default in DEFAULT_ENABLED (modules/preferences) because that record is
/// keyed exhaustively, which is deliberate — an intent shipped without a
/// considered default is a silent product decision.
enum NotificationIntent {
  TOP_RELEVANT_COMPETITION
  REGISTRATION_CLOSING
  FEATURE_ANNOUNCEMENT

  /// Operational, and the only intent whose audience is not "any user": it
  /// reaches the people the platform authorization model says review
  /// competition suggestions. See `policy/intent-audience.ts`.
  ADMIN_COMPETITION_SUGGESTION
}

model NotificationPreference {
  id        String             @id @default(cuid())
  userId    String
  intent    NotificationIntent
  enabled   Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, intent])
  @@index([userId])
  @@map("notification_preference")
}

// Values must mirror DimensionId in modules/recommendations/engine/types.ts
// exactly — this is the persisted form of that TS union, not an
// independently-maintained enum. Adding a 14th dimension there means adding
// the matching value here, nothing else.
enum CompetitionPreferenceDimension {
  mode
  categories
  technologies
  eligibilities
  competitionType
  location
  registrationPlatform
  registrationType
  registrationFeeType
  organizerType
  difficulty
  certificateType
  status
  teamSize
}

model CompetitionPreference {
  id        String                         @id @default(cuid())
  userId    String
  dimension CompetitionPreferenceDimension
  value     String
  weight    Float
  createdAt DateTime                       @default(now())
  updatedAt DateTime                       @updatedAt
  user      User                           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dimension, value])
  @@index([userId])
  @@map("competition_preference")
}

/// One thing a user is told, once.
///
/// Channel-independent: the same row backs the inbox and every push that
/// refers to it. `title`/`body`/`payload` are a SNAPSHOT taken at generation
/// time, not a view over live competition rows — a competition edited or
/// deleted later must not rewrite history, and the inbox must render without
/// re-reading every subject it mentions.
model Notification {
  id     String             @id @default(cuid())
  userId String
  intent NotificationIntent

  /// Idempotency key for "this user, this intent, this occasion" — e.g.
  /// `top:2026-09-17`, `closing:2026-09-17`, `announcement:<id>`. Always
  /// stamped by the scheduler and carried in the job payload, never derived
  /// from a worker's clock (ND-D-07): a retry that crosses UTC midnight would
  /// otherwise compute a different key and generate a second notification for
  /// the same occasion.
  occurrenceKey String

  title String
  body  String

  /// Site-relative path only, enforced by a CHECK constraint in the migration
  /// as well as by validation. Storing an absolute URL here would both couple
  /// the record to one client and make an open redirect one forgotten
  /// validation away.
  actionPath String?

  /// Structured render snapshot, so a future non-web client can present this
  /// notification without re-deriving it. See clients-and-channels.md.
  payload Json?

  createdAt DateTime @default(now())

  /// Seen in the inbox. Independent of every delivery's status, and of
  /// respondedAt (ND-H-10).
  readAt DateTime?

  /// Clicked through to the action. Independent of readAt.
  respondedAt DateTime?

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  targets    NotificationTarget[]
  deliveries NotificationDelivery[]

  @@unique([userId, intent, occurrenceKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notification")
}

/// What one notification is about. A child collection rather than a column or
/// a JSON array, because an aggregated notification covers several subjects
/// and deduplication has to be an index scan rather than a scan of every
/// notification the user has (ND-H-11).
model NotificationTarget {
  id             String @id @default(cuid())
  notificationId String

  /// Denormalized from `notification.userId`, deliberately NOT a foreign key.
  /// It exists solely so "has this user already been told about competition X
  /// at this version?" needs no join. User deletion still reaches these rows
  /// through Notification's cascade.
  userId String

  targetType NotificationTargetType
  targetId   String

  /// Identity of the *occasion*, not of the entity — the registration deadline
  /// as epoch milliseconds, for the deadline intent. A moved deadline is a new
  /// occasion and may notify again; an unchanged one is a duplicate and is
  /// suppressed (ND-H-12). Null for subjects that cannot recur.
  targetVersion String?

  rank      Int
  createdAt DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, targetType, targetId])
  @@index([userId, targetType, targetId, targetVersion])
  @@index([targetType, targetId])
  @@map("notification_target")
}

/// One (notification, channel, destination) delivery, with its own state and
/// its own retries.
///
/// IN_APP rows are created already DELIVERED: for an inbox, the row being
/// committed and visible IS the delivery, and there is no later event to wait
/// for (ND-D-04). WEB_PUSH SENT means the provider ACCEPTED the message —
/// there is no "the user saw it" signal on the web, and DELIVERED is reserved
/// for a channel that can genuinely report one.
model NotificationDelivery {
  id             String                     @id @default(cuid())
  notificationId String
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  maxAttempts    Int
  lastAttemptAt  DateTime?
  nextAttemptAt  DateTime?

  /// Why this delivery is in a terminal or skipped state, in words. Read by
  /// humans debugging "why did this not arrive", not by code.
  failureReason String?

  provider           PushProviderId?
  providerMessageId  String?
  pushSubscriptionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notification     Notification                  @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  pushSubscription PushSubscription?             @relation(fields: [pushSubscriptionId], references: [id], onDelete: SetNull)
  attemptLog       NotificationDeliveryAttempt[]

  /// NOTE: Postgres treats NULLs as distinct, so this does NOT constrain
  /// IN_APP rows, whose pushSubscriptionId is null. A hand-written PARTIAL
  /// unique index in the migration covers that case; Prisma cannot express
  /// one, so in-app rows are created-and-catch-P2002, never upserted.
  @@unique([notificationId, channel, pushSubscriptionId])
  @@index([status, nextAttemptAt])
  @@index([notificationId])
  @@map("notification_delivery")
}

/// Per-attempt audit trail. The answer to "was it attempted, how many times,
/// and what did the provider say", which no single status column can carry.
model NotificationDeliveryAttempt {
  id            String @id @default(cuid())
  deliveryId    String
  attemptNumber Int

  startedAt        DateTime                     @default(now())
  finishedAt       DateTime?
  outcome          NotificationDeliveryOutcome?
  errorCode        String?
  providerResponse Json?

  delivery NotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attemptNumber])
  @@index([deliveryId])
  @@map("notification_delivery_attempt")
}

/// A browser's push registration.
///
/// `token` is globally unique because a token identifies a BROWSER, not a
/// person: the same browser signing in as a different user must move this
/// row's userId, never insert a second row, or a legitimate re-registration
/// is rejected by the unique constraint.
model PushSubscription {
  id       String         @id @default(cuid())
  userId   String
  provider PushProviderId @default(FCM)
  token    String         @unique

  userAgent String?
  status    PushSubscriptionStatus @default(ACTIVE)

  /// Reset to 0 on any accepted send. At the configured ceiling the row is
  /// marked INVALID defensively — a token can be dead in a way the provider
  /// never reports cleanly (ND-D-09).
  consecutiveFailures Int @default(0)

  lastSeenAt    DateTime  @default(now())
  lastSuccessAt DateTime?
  invalidatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, status])
  @@map("push_subscription")
}

/// The durable work queue. Postgres is the broker; the WorkQueue port in
/// modules/notifications/jobs is the seam a real broker would slot into
/// (ND-D-02, ND-D-10).
///
/// Claiming is a single UPDATE ... FOR UPDATE SKIP LOCKED that takes a lease.
/// `attempts` increments ON CLAIM, not on completion: a worker that crashes
/// mid-job must still burn an attempt, or an expired lease re-claims it
/// forever.
model NotificationJob {
  id   String              @id @default(cuid())
  kind NotificationJobKind

  /// `<kind>:<scope>:<occurrence>`. Unique, so a scheduler that runs twice is
  /// a no-op — the uniqueness violation means "already scheduled", which is
  /// the desired end state (ND-D-06).
  dedupeKey String @unique

  status NotificationJobStatus @default(PENDING)

  /// The one timing primitive. Instant and near-real-time work sets it to now
  /// and is bounded by sweep cadence; scheduled work sets the next configured
  /// hour; relative work sets deadline minus offset; an announcement sets its
  /// own delivery time. On claim it is pushed to the lease expiry, so one
  /// index serves both "due" and "lease expired".
  runAt DateTime

  attempts    Int @default(0)
  maxAttempts Int

  /// Carries the frozen decision inputs — occurrence key, window bounds,
  /// evaluation anchor, fan-out cursor. A retry must reproduce the same
  /// decision, so nothing here is derived from the worker's clock (ND-D-07).
  payload Json

  leaseOwner     String?
  leaseExpiresAt DateTime?
  lastError      String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status, runAt])
  @@index([status, completedAt])
  @@map("notification_job")
}

/// An admin-authored platform announcement. The first notification subject
/// that is not a competition (ND-I-21).
model FeatureAnnouncement {
  id    String @id @default(cuid())
  title String
  body  String

  /// https:// absolute, or a site-relative path. Optional — an announcement
  /// with nothing to link to is legitimate. Validated on the way in; this is
  /// the one place notification content is authored by a human.
  url String?

  createdById String?

  /// Delivery time is a property of the announcement. "Send now" is a schedule
  /// time of now; there is no separate immediate path (ND-I-22).
  scheduledFor DateTime

  status      FeatureAnnouncementStatus @default(DRAFT)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User? @relation("featureAnnouncementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@map("feature_announcement")
}

/// Last-run marker for one registered internal task.
///
/// Exists because the deployment target allows very few cron entries, so a
/// single tick endpoint dispatches every scheduled task and each needs its own
/// cadence. Durable rather than in-memory because every Vercel invocation is a
/// fresh process.
model InternalJobRun {
  taskId     String    @id
  lastRunAt  DateTime?
  lastStatus String?
  lastError  String?
  runCount   Int       @default(0)
  updatedAt  DateTime  @updatedAt

  @@map("internal_job_run")
}

model Competition {
  id                             String                    @id @default(cuid())
  title                          String
  slug                           String                    @unique
  shortDescription               String?
  organizer                      String?
  mode                           CompetitionMode?
  minTeamSize                    Int?
  maxTeamSize                    Int?
  registrationLink               String?
  website                        String?
  startDate                      DateTime?
  endDate                        DateTime?
  registrationDeadline           DateTime?
  prizePool                      String?
  logoAssetId                    String?
  bannerAssetId                  String?
  coverAssetId                   String?
  contentId                      String?                   @unique
  visibility                     CompetitionVisibility     @default(PRIVATE)
  status                         CompetitionStatus?
  createdById                    String?
  updatedById                    String?
  createdAt                      DateTime                  @default(now())
  updatedAt                      DateTime                  @updatedAt
  deletedAt                      DateTime?
  registrationPlatform           RegistrationPlatform?
  registrationType               RegistrationType?
  registrationFeeType            RegistrationFeeType?
  registrationFee                String?
  organizerType                  OrganizerType?
  difficulty                     DifficultyLevel?
  certificateType                CertificateType?
  automaticStatusUpdatesDisabled Boolean                   @default(false)
  registrationStartDate          DateTime?
  statusUpdatedAt                DateTime?
  bannerAsset                    Asset?                    @relation("competitionBanner", fields: [bannerAssetId], references: [id], onDelete: SetNull)
  content                        Content?                  @relation("CompetitionContent", fields: [contentId], references: [id], onDelete: SetNull)
  coverAsset                     Asset?                    @relation("competitionCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  createdBy                      User?                     @relation("competitionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  logoAsset                      Asset?                    @relation("competitionLogo", fields: [logoAssetId], references: [id], onDelete: SetNull)
  updatedBy                      User?                     @relation("competitionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  bookmarks                      CompetitionBookmark[]
  categories                     CompetitionCategory[]
  eligibilities                  CompetitionEligibility[]
  locations                      CompetitionLocation[]
  members                        CompetitionMember[]
  projects                       CompetitionProject[]
  registrations                  CompetitionRegistration[]
  suggestions                    CompetitionSuggestion[]   @relation("competitionSuggestionTarget")
  technologies                   CompetitionTechnology[]
  types                          CompetitionTypeRelation[]
  links                          Link[]

  @@index([status])
  @@index([visibility])
  @@index([deletedAt])
  @@index([startDate])
  @@index([registrationDeadline])
  @@index([registrationStartDate])
  @@index([createdById])
  @@index([updatedById])
  @@map("competition")
}

model CompetitionSuggestion {
  id                  String                       @id @default(cuid())
  status              SuggestionStatus             @default(DRAFT)
  submittedAt         DateTime?
  reviewedAt          DateTime?
  reviewNotes         String?                      @db.Text
  rejectionReason     String?                      @db.Text
  competitionId       String?
  submittedById       String
  reviewedById        String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  deletedAt           DateTime?
  suggestionContentId String?                      @unique
  suggestionTitle     String
  competition         Competition?                 @relation("competitionSuggestionTarget", fields: [competitionId], references: [id], onDelete: SetNull)
  reviewedBy          User?                        @relation("competitionSuggestionReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  submittedBy         User                         @relation("competitionSuggestionSubmittedBy", fields: [submittedById], references: [id], onDelete: Cascade)
  suggestionContent   Content?                     @relation("CompetitionSuggestionContent", fields: [suggestionContentId], references: [id], onDelete: SetNull)
  assets              CompetitionSuggestionAsset[]
  links               Link[]

  @@index([status])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([competitionId])
  @@index([createdAt])
  @@map("competition_suggestion")
}

model CompetitionSuggestionAsset {
  suggestionId String
  assetId      String
  order        Int                   @default(0)
  createdAt    DateTime              @default(now())
  asset        Asset                 @relation(fields: [assetId], references: [id], onDelete: Cascade)
  suggestion   CompetitionSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@id([suggestionId, assetId])
  @@index([suggestionId, order])
  @@index([assetId])
  @@map("competition_suggestion_asset")
}

model CompetitionMember {
  competitionId String
  userId        String
  role          CompetitionMemberRole @default(MAINTAINER)
  assignedAt    DateTime              @default(now())
  competition   Competition           @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([competitionId, userId])
  @@map("competition_member")
}

model CompetitionCategory {
  competitionId String
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@id([competitionId, categoryId])
  @@map("competition_category")
}

model CompetitionTechnology {
  competitionId String
  technologyId  String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  technology    Technology  @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([competitionId, technologyId])
  @@map("competition_technology")
}

model CompetitionEligibility {
  competitionId String
  type          EligibilityType
  competition   Competition     @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@id([competitionId, type])
  @@index([type])
  @@map("competition_eligibility")
}

model CompetitionTypeRelation {
  competitionId String
  type          CompetitionType

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@id([competitionId, type])
  @@index([type])
  @@map("competition_type")
}

model CompetitionBookmark {
  competitionId String
  userId        String
  createdAt     DateTime    @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([competitionId, userId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("competition_bookmark")
}

/// A user's own record that they registered for this competition on the
/// organizer's external platform.
///
/// SELF-DECLARED AND UNVERIFIED. Kizunia is a discovery platform, not the
/// organizer, and has no channel to confirm any of this. Nothing here may
/// ever be presented as organizer-confirmed. There is deliberately no
/// `source`, no `verifiedAt` and no status enum — each would imply a
/// verification pipeline that does not exist and is not planned.
///
/// Fully independent of CompetitionBookmark. All four combinations of
/// (bookmarked, registered) are legal and neither write ever touches the
/// other table.
///
/// Never removed by lifecycle. A row here survives every CompetitionStatus,
/// including COMPLETED and CANCELLED — "I registered for that" stays true
/// after the event ends. Past-vs-upcoming is derived at read time from the
/// competition's dates, never by deleting rows.
model CompetitionRegistration {
  competitionId String
  userId        String
  /// When the user told us. NOT when they actually registered with the
  /// organizer — we cannot know that.
  markedAt      DateTime    @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([competitionId, userId])
  @@index([userId, markedAt(sort: Desc)])
  @@map("competition_registration")
}

/// A real-world place, stored at whatever precision is actually known.
///
/// Locations are deliberately NOT deduplicated across competitions. Two
/// competitions in Pune each own a private Location row, so editing one can
/// never silently rewrite another competition's data. The cost of duplicate
/// rows is far lower than the cost of fuzzy place matching.
model Location {
  id                 String                @id @default(cuid())
  /// Human-readable name shown in the UI, e.g. "Pune, Maharashtra, India".
  /// This is the only field an admin is ever required to supply.
  displayName        String
  precision          LocationPrecision     @default(UNKNOWN)
  country            String?
  /// ISO 3166-1 alpha-2, uppercase.
  countryCode        String?               @db.VarChar(2)
  state              String?
  stateCode          String?
  city               String?
  postalCode         String?
  /// Decimal rather than Float so stored coordinates round-trip exactly.
  /// 6 decimal places is roughly 0.11 m at the equator.
  latitude           Decimal?              @db.Decimal(9, 6)
  longitude          Decimal?              @db.Decimal(9, 6)
  /// IANA timezone identifier, e.g. "Asia/Kolkata".
  timezone           String?
  provider           LocationProvider      @default(MANUAL)
  /// Opaque id from the external provider. Kept for re-enrichment only —
  /// never required to read a Location back.
  providerLocationId String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  competitions       CompetitionLocation[]
  searchAreas        LocationSearchArea[]

  @@index([countryCode])
  @@index([city])
  @@index([state])
  @@index([provider, providerLocationId])
  @@index([latitude, longitude])
  @@map("location")
}

/// A specific geographic entity a user can select as a search boundary.
///
/// A SearchArea is an *entity*, never a name. "Nashik City" and "Nashik
/// District" share a word but have different boundaries and different search
/// semantics, so they are two rows — distinguished by `identityKey`, which is
/// derived from provider identity wherever one exists.
///
/// Unlike Location (which is competition-owned and never shared), SearchAreas
/// are deliberately reused: every competition in Pune links to the same Pune
/// row, which is what makes "everything in Pune" a single indexed lookup.
model SearchArea {
  id                 String               @id @default(cuid())
  displayName        String
  /// The provider's own type string, stored verbatim — "locality",
  /// "administrative_area_level_2", "sublocality_level_1", "university".
  ///
  /// Display and disambiguation only; nothing branches on it. Deliberately not
  /// a Kizunia enum, because any fixed set would encode one country's
  /// administrative hierarchy as though it were universal.
  providerKind       String?
  /// Parent context for pickers, e.g. "Maharashtra, India", so a user can tell
  /// two same-named entities apart. Display only.
  contextLabel       String?
  provider           LocationProvider?
  providerLocationId String?
  /// Deterministic identity, and the dedup key:
  /// google:place:{placeId}                        preferred, whenever available
  /// component:{providerKind}:{name}:{parent ctx}  fallback only
  ///
  /// Never the display name alone. That would collapse Nashik City and Nashik
  /// District into one entity and merge unrelated places that share a name.
  identityKey        String               @unique
  latitude           Decimal?             @db.Decimal(9, 6)
  longitude          Decimal?             @db.Decimal(9, 6)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  locations          LocationSearchArea[]

  @@index([displayName])
  @@map("search_area")
}

/// Verified containment: this location is discoverable through this area.
///
/// Containment is materialized here at ingestion rather than traversed at query
/// time. That is what makes a parent search reach its children (they each point
/// at the parent) while making upward or sideways expansion impossible — a
/// Kondhwa location simply has no Bibwewadi row, so it can never surface there.
model LocationSearchArea {
  locationId   String
  searchAreaId String
  relation     SearchAreaRelation
  /// Which provider evidence produced this link. Kept so "why is this
  /// competition discoverable through Bibwewadi?" is answerable later.
  source       SearchAreaSource
  createdAt    DateTime           @default(now())
  location     Location           @relation(fields: [locationId], references: [id], onDelete: Cascade)
  searchArea   SearchArea         @relation(fields: [searchAreaId], references: [id], onDelete: Cascade)

  @@id([locationId, searchAreaId])
  @@index([searchAreaId])
  @@map("location_search_area")
}

/// How one competition uses one location.
///
/// Carries its own identity rather than a composite key because the same place
/// can legitimately host two stages of one competition (a Pune qualifier and a
/// Pune final), and because label/venue/dates describe the *usage*, not the place.
model CompetitionLocation {
  id            String      @id @default(cuid())
  competitionId String
  locationId    String
  /// Free-form context for this stop, e.g. "Qualifier", "Final",
  /// "Opening Ceremony". Deliberately not an enum — competition structures vary
  /// too widely to enumerate, and nothing in the system branches on this value.
  label         String?
  venueName     String?
  address       String?
  /// Dates for this location specifically. May differ from the competition's
  /// overall window, e.g. a regional qualifier inside a three-month event.
  startDate     DateTime?
  endDate       DateTime?
  /// Admin-defined display order. Database row order is never relied upon.
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  location      Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([competitionId, order])
  @@index([locationId])
  @@map("competition_location")
}

